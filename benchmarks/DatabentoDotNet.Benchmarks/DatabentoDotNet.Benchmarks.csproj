<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      Both of these are load-bearing, and neither is obvious.

      IsPackable keeps `dotnet pack -c Release` at the repository root from producing a
      DatabentoDotNet.Benchmarks package. Nothing here ships.

      IsTestProject=false keeps `dotnet test` from running it. Without it, `dotnet test` at the
      root finds this assembly, because xunit.runner.visualstudio reaches it transitively through
      the Live test project reference below and registers its adapter — and the run then reports
      "Catastrophic failure: Test process did not return valid JSON" for a project that has no
      tests. Explicitly false rather than merely unset: Directory.Build.targets reads the same
      property, so leaving it empty would work by accident today and stop working the moment
      someone tightened that condition.
    -->
    <IsTestProject>false</IsTestProject>
    <!--
      Read by Directory.Build.targets, which otherwise turns the AOT and trim analyzers on for
      every project that is not a test project. BenchmarkDotNet generates and compiles a project
      per run and drives it by reflection, so those analyzers would report the harness rather than
      this repository — and TreatWarningsAsErrors would then fail the build over a package doing
      exactly what it is for.
    -->
    <IsBenchmarkProject>true</IsBenchmarkProject>
    <!--
      xunit.v3 generates a Main for any Exe that references it, and its build assets reach here
      transitively through the Live test project below. Two entry points is a compile error
      (CS0017), and the one this project wants is BenchmarkSwitcher's — see Program.cs.
    -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <!--
    The mock gateway and the synthetic MBO builder live in the Live test project, and this
    references them rather than growing a second copy. A benchmark-only gateway would be a third
    implementation of the same protocol — after MockLiveGateway and the real one — and the whole
    argument this repo makes about doubles is that two things written from the same reading agree
    with each other. A third would be worse, not better, and it would drift the moment the mock
    was corrected against a real gateway.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/DatabentoDotNet.Dbn/DatabentoDotNet.Dbn.csproj" />
    <ProjectReference Include="../../src/DatabentoDotNet.Live/DatabentoDotNet.Live.csproj" />
    <ProjectReference Include="../../tests/DatabentoDotNet.Live.Tests/DatabentoDotNet.Live.Tests.csproj" />
  </ItemGroup>

</Project>
