<Project>

  <!--
    Target frameworks.

    net11.0 is where DBN's Zstandard transport compression becomes dependency-free via the
    BCL's System.IO.Compression.ZstandardStream. .NET 11 is still preview (GA 2026-11-10), so
    the net11.0 target is enabled automatically only when an SDK that can build it is present.
    This keeps `dotnet build` green on a .NET 10 GA SDK today.
  -->
  <PropertyGroup>
    <!-- NETCoreSdkVersion is empty in some early evaluation contexts, so default the major to 0. -->
    <_SdkMajor>0</_SdkMajor>
    <_SdkMajor Condition="'$(NETCoreSdkVersion)' != ''">$(NETCoreSdkVersion.Split('.')[0])</_SdkMajor>
    <HasNet11Sdk>false</HasNet11Sdk>
    <HasNet11Sdk Condition="'$(_SdkMajor)' != '0' AND $(_SdkMajor) &gt;= 11">true</HasNet11Sdk>
  </PropertyGroup>

  <PropertyGroup>
    <LibraryTargetFrameworks>net10.0</LibraryTargetFrameworks>
    <LibraryTargetFrameworks Condition="'$(HasNet11Sdk)' == 'true'">net10.0;net11.0</LibraryTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Native AOT / trimming friendliness is a hard requirement for the codec, but the gate for it
    lives in Directory.Build.targets, not here. It depends on $(IsTestProject), which the test
    project sets in its own body; Directory.Build.props is imported before that body is
    evaluated, so a Condition here would always see an empty value. See Directory.Build.targets.
  -->

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Pre-1.0 until the M5 release milestone. 1.0.0 is reserved for full parity with
    databento-rs (live + historical + reference data), per ROADMAP.md.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Herbert Sabanal</Authors>
    <Product>databento-dotnet</Product>
    <RepositoryUrl>https://github.com/jerbersoft/databentodotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>databento;market-data;dbn;trading;real-time;historical</PackageTags>
  </PropertyGroup>

</Project>
