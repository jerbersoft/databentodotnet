<Project>

  <!--
    Target frameworks.

    net10.0 only, deliberately. The net11.0 target was dropped in #16: it existed to pick up
    System.IO.Compression.ZstandardStream from the BCL, but the .NET 11 preview SDK is not
    installed on dev machines, so that branch was compiled nowhere and its risk was structural
    rather than incidental. Restore it when .NET 11 is GA — see Internal/ZstdDecompressor.cs,
    which is still the one seam that would need to change.
  -->
  <PropertyGroup>
    <LibraryTargetFrameworks>net10.0</LibraryTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Native AOT / trimming friendliness is a hard requirement for the codec, but the gate for it
    lives in Directory.Build.targets, not here. It depends on $(IsTestProject), which the test
    project sets in its own body; Directory.Build.props is imported before that body is
    evaluated, so a Condition here would always see an empty value. See Directory.Build.targets.
  -->

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Pre-1.0 until the M5 release milestone. 1.0.0 is reserved for full parity with
    databento-rs (live + historical + reference data), per ROADMAP.md.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Herbert Sabanal</Authors>
    <Product>databento-dotnet</Product>
    <RepositoryUrl>https://github.com/jerbersoft/databentodotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>databento;market-data;dbn;trading;real-time;historical</PackageTags>
  </PropertyGroup>

</Project>
