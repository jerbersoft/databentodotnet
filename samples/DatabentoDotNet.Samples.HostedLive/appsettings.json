{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Extensions.Hosting": "Warning"
    }
  },
  "Databento": {
    "Live": {
      "equities": {
        "Dataset": "EQUS.MINI",
        "Subscriptions": [
          {
            "Schema": "trades",
            "StypeIn": "raw_symbol",
            "Symbols": ["AAPL", "MSFT", "NVDA"]
          }
        ],
        "Reconnect": {
          "Enabled": true,
          "InitialDelay": "PT1S",
          "MaxDelay": "PT30S",
          "MaxAttempts": 10
        }
      }
    }
  }
}
