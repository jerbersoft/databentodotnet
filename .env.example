# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, so it must never
# carry a real key.
#
# Used only by the opt-in tests (`Category=Live`, `Category=Historical` and `Category=Reference`).
# Every other test
# runs without it, and CI is never given one — see LiveCredentials.cs, HistoricalCredentials.cs and
# ReferenceCredentials.cs in the three test projects. One key serves all three.
DATABENTO_API_KEY=$YOUR_API_KEY

# The dataset the live smoke test authenticates against. It must be one this account holds a
# *live* data license for, which is a separate thing from historical access: an account with
# full historical access is still answered with
#   success=0|error=A live data license is required to access XNAS.ITCH.
# on a dataset it has not licensed for live. Defaults to EQUS.MINI when unset.
DATABENTO_LIVE_DATASET=EQUS.MINI

# The schema the live *session* test subscribes to, in its DBN wire spelling — `trades`,
# `mbp-1`, `ohlcv-1d`. It must be one the dataset above offers *and* this account is licensed
# for. Defaults to `trades` when unset. Note that `mbo` is a venue-feed schema and is not on
# EQUS.MINI at all; see ROADMAP.md §4.
DATABENTO_LIVE_SCHEMA=trades

# The symbols RealGatewayLatencyTests subscribes to, comma-separated. Named symbols rather than
# ALL_SYMBOLS on purpose: a percentile needs thousands of observations, and the quick way to get
# them is a firehose that is billed by what it delivers. Defaults to eight liquid US names, which
# fill the sample in seconds during market hours. Move this with DATABENTO_LIVE_DATASET — point
# that at a futures feed and `AAPL` names nothing, so the session would start, cost money and
# collect no observations at all.
#
# DATABENTO_LIVE_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,SPY

# The second gate, and the only one that costs money. Everything above runs tests that stop
# short of `start_session`, and no data — and so no bill — moves until that line is sent. Leave
# it unset (or 0) for an ordinary `dotnet test`.
#
# Set it to 1 to also run the two tests that start a session:
#
#   RealGatewaySessionTests   connects, reads eight records, closes. Seconds, and near-free.
#   RealGatewayLatencyTests   the #65 latency benchmark. Streams for up to 60 seconds or 20,000
#                             records, whichever comes first, and needs an OPEN MARKET — it fails
#                             with a message saying so if too few records arrive to support a p99.
#                             Materially more data than the one above, though still small: a
#                             minute of `trades` for eight symbols.
#
# DATABENTO_LIVE_SESSION=1


# ----------------------------------------------------------------------------------------------
# Historical API (`Category=Historical`, tests/DatabentoDotNet.Historical.Tests)
# ----------------------------------------------------------------------------------------------

# The dataset the historical metadata tests query. Note that this is a *different* entitlement
# question from DATABENTO_LIVE_DATASET above: a live data license and historical access are
# separate things, and every endpoint these tests reach is discovery or a billing enquiry, which
# the API answers for any dataset in the catalog rather than only for entitled ones. Defaults to
# GLBX.MDP3 — upstream's own example dataset throughout metadata.rs — when unset.
DATABENTO_HISTORICAL_DATASET=GLBX.MDP3

# The schema the billing enquiries price, in its DBN wire spelling. Offered per dataset, so it has
# to move with the line above. Defaults to `trades` when unset.
DATABENTO_HISTORICAL_SCHEMA=trades

# The symbol the billing enquiries query. ESH4 is the March 2024 E-mini S&P 500 future — expired,
# and chosen for that: a settled contract over a settled day has a record count that does not move,
# so the tests do not quietly change meaning with the calendar. Moves with the dataset and the date.
DATABENTO_HISTORICAL_SYMBOL=ESH4

# The single UTC day the billing enquiries cover, as yyyy-MM-dd. Must sit inside the dataset's
# available history — one of the tests asserts exactly that, so a bad value here fails loudly
# rather than returning a zero that looks like agreement. Defaults to 2024-01-02 when unset.
DATABENTO_HISTORICAL_DATE=2024-01-02

# The second gate, and the only one that costs money. Everything above runs endpoints that are
# discovery or billing enquiries — `get_cost` exists precisely to be called *before* committing to
# a request — so no data, and no bill, is generated by any of them. This gate is for the tests that
# download data: `timeseries.get_range` (#38) and `batch.submit_job` (#39). It ships ahead of them
# deliberately, so the first billable test arrives behind a gate that already exists rather than one
# written in the same commit that first needs it.
#
# DATABENTO_HISTORICAL_REQUEST=1


# ----------------------------------------------------------------------------------------------
# Reference API (`Category=Reference`, tests/DatabentoDotNet.Reference.Tests)
# ----------------------------------------------------------------------------------------------

# Reference data is a *third* entitlement, separate from both lines above: an account with full
# historical and live access is still answered 403 here until reference data is added to it. The
# free tests cannot tell you that, because the two endpoints they call — corporate_actions.list_enums
# and corporate_actions.list_events — are unauthenticated. Measured on 2026-08-29: both answer 200
# with their full bodies to a request carrying no Authorization header at all, while
# corporate_actions.get_range refuses the same fake key with 401. That is what establishes those two
# as free rather than merely cheap, and it means re-capturing the vendored fixtures in
# tests/DatabentoDotNet.Reference.Tests/Data/ needs no key at all.

# The symbol the billable tests query. AAPL is a US listing with a dense and entirely settled
# corporate-actions history — a quarterly dividend inside any month-long window, and splits far
# enough back that adjustment_factors has something to say. Reference data is keyed by security
# rather than by dataset, so there is no dataset variable to move with it. Defaults to AAPL.
DATABENTO_REFERENCE_SYMBOL=AAPL

# The inclusive first day of the queried range, as yyyy-MM-dd. Defaults to 2024-02-01.
DATABENTO_REFERENCE_START=2024-02-01

# The day the queried range ends *before*, as yyyy-MM-dd. Defaults to 2024-03-01 — a month, and
# deliberately small: these endpoints bill by what they return, and every question the suite asks of
# them (is the end exclusive, is the server's order the index's order, what magnitudes do the rates
# carry) is answerable from a handful of rows. Widening it costs money and answers nothing new.
#
# Note that "ends before" is upstream's documented claim about this end and is exactly what
# RealReferenceRequestTests probes. It is not a settled fact until that test has run.
DATABENTO_REFERENCE_END=2024-03-01

# The second gate, and the only one that costs money. Everything above runs endpoints that do not
# authenticate and cannot bill. This gate is for the tests that request rows: the three
# get_range endpoints and security_master.get_last.
#
# Those tests also send allocate_isins=false, against the library's own default of true. Databento
# allocates an ISIN to a security on request and an ISIN-limited plan has a finite number of those;
# a request for a symbol the account has not seen can consume one, which is a side effect that
# outlives the run and that re-running does not undo. Nothing in the suite reads an ISIN.
#
# DATABENTO_REFERENCE_REQUEST=1
