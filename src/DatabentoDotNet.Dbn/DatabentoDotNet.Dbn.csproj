<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      DatabentoDotNet.* throughout — package ID, assembly, and namespace. "DotNet" reads as
      .NET rather than .NET Framework, and it keeps us out of Databento.*, which is the
      vendor's namespace and an unreserved NuGet prefix they could claim at any time.
    -->
    <PackageId>DatabentoDotNet.Dbn</PackageId>
    <AssemblyName>DatabentoDotNet.Dbn</AssemblyName>
    <RootNamespace>DatabentoDotNet.Dbn</RootNamespace>
    <Description>Databento Binary Encoding (DBN) codec for .NET: zero-copy record decoding, metadata, and symbol mapping.</Description>
  </PropertyGroup>

  <!--
    Zstandard, for DBN's transport compression. ZstdSharp.Port is pure managed — no P/Invoke, no
    native asset, no per-RID build — so the package stays trim- and AOT-friendly.

    This was conditional on net10.0 while a net11.0 target existed to use the BCL's
    ZstandardStream instead. That target was dropped in #16; see Internal/ZstdDecompressor.cs.
  -->
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
