# Build output
[Bb]in/
[Oo]bj/
artifacts/
*.user
*.suo

# IDE
.vs/
.vscode/
.idea/
*.DotSettings.user

# BenchmarkDotNet writes its reports and the projects it generates per run here, next to
# wherever it was invoked from. They are results, not source.
BenchmarkDotNet.Artifacts/

# DocFX. `docs/_site/` is the rendered site and `docs/api/*.yml` is the API metadata generated
# from the four projects — both are build output. The generator's own exclusion lives in
# docs/api/.gitignore, next to the hand-written index.md it has to keep.
docs/_site/

# Test / coverage
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
*.coverage

# NuGet
*.nupkg
*.snupkg
packages/

# OS
.DS_Store
Thumbs.db

# Secrets. The live API key lives here; it is read by the opt-in smoke tests and by
# nothing else. Never commit it — a key in git history is a key that has to be rotated,
# and `git add -A` does not ask.
.env
.env.*
!.env.example
