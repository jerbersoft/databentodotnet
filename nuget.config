<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Clear inherited sources so restore is reproducible on any machine and this public library
    can never pick up a package from someone's private feed.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
