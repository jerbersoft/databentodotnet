<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DatabentoDotNet.Dbn/DatabentoDotNet.Dbn.csproj" />
  </ItemGroup>

  <!--
    Vendored DBN fixture corpus (see Data/README.md for provenance). Globbed by extension
    rather than 71 hand-written entries, so a future re-vendor that adds or removes files needs
    no csproj edit. Four patterns, not one, because "*.dbn" alone would not match the
    ".dbn.zst" / ".dbn.frag" / ".dbn.frag.zst" variants — MSBuild's "*" does not span the
    interior dots. TestFixturesTests asserts the count landed correctly, so a broken glob (or a
    partial vendor) fails the build instead of silently starving downstream decoder tests of
    coverage. Data/README.md itself is intentionally not included here: it is provenance
    documentation, not something a test needs to read at run time.
  -->
  <ItemGroup>
    <Content Include="Data/*.dbn" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data/*.dbn.zst" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data/*.dbn.frag" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data/*.dbn.frag.zst" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
